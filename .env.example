# ==============================================================================
# AutoPatch-Kernel: 100% Free Local Configuration (Zero Paid APIs / Zero Cards)
# ==============================================================================

# Execution Mode: "local_free" runs 100% locally with zero paid services
AUTOPATCH_MODE=local_free
AUTOPATCH_OFFLINE_FALLBACK=true
AUTOPATCH_ENVIRONMENT=development
AUTOPATCH_LOG_LEVEL=INFO

# Local Meta Open-Weight Model Endpoints (Ollama / vLLM)
# Default Ollama endpoint (Free, open-source local inference)
OLLAMA_API_BASE=http://localhost:11434/v1
VLLM_API_BASE=http://localhost:8000/v1

# Meta Open-Weight Model Identifiers
META_TRIAGE_MODEL=muse-glimmer-open    # Maps to llama3.2:3b for fast triage
META_REASONING_MODEL=muse-spark-open   # Maps to llama3.3:70b or llama3.1:8b for repair

# Local Git Worktree & Sandbox Isolation
AUTOPATCH_WORKTREE_DIR=.autopatch/worktrees
AUTOPATCH_LOCAL_SANDBOX=true

# (Optional) Optional Cloud / External Integrations
# Only needed if manually enabling Modal or GitHub Pull Request automated pushing
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
GITHUB_TOKEN=
GITHUB_REPOSITORY=Mahesh-Paul/AutoPatch-Kernel-Autonomous-Self-Healing-Codebase-Agent-Built-on-MCP
